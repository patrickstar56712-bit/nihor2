{
  "functions": {
    "api/admin.js": {
      "includeFiles": "api/_panel/**"
    }
  },
  "redirects": [
    { "source": "/123lobby", "destination": "/123lobby/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/123lobby/", "destination": "/123lobby/index.html" },
    { "source": "/((?!api/|123lobby/)[^.]*)", "destination": "/index.html" }
  ]
}
